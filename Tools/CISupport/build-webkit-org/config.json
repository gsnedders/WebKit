  "schedulers": {
    "$let": {
      "main_builders": [
        "GTK-Linux-64-bit-Release-Build", "GTK-Linux-64-bit-Debug-Build",
        "GTK-Linux-64-bit-Release-Clang-Build", "GTK-Linux-64-bit-Release-Debian-Stable-Build",
        "GTK-Linux-64-bit-Release-Ubuntu-2204-Build", "GTK-Linux-64-bit-Release-Ubuntu-LTS-Build",
        "GTK-Linux-64-bit-Release-GTK3-Build", "GTK-Linux-64-bit-Release-SDK-Container",
        "WPE-Linux-64-bit-Release-Ubuntu-2204-Build", "WPE-Linux-64-bit-Release-Ubuntu-LTS-Build",
        "WPE-Linux-64-bit-Release-SDK-Container", "WPE-Linux-RPi4-32bits-Mesa-Release-Perf-Build",
        "WPE-Linux-RPi4-64bits-Mesa-Release-Perf-Build", "JSCOnly-Linux-AArch64-Release",
        "JSCOnly-Linux-ARMv7-Thumb2-Release", "PlayStation-Release-Build", "PlayStation-Debug-Build",
        "Windows-64-bit-Release-Build", "Windows-64-bit-Debug-Build",
        "WPE-Linux-64-bit-Release-Build", "WPE-Linux-64-bit-Debug-Build",
        "WPE-Linux-64-bit-Release-Clang-Build", "WPE-Linux-64-bit-Release-LibWebRTC-Build",
        "WPE-Linux-ARM64-bit-Release-Debian-Stable-Build", "WPE-Linux-ARM32-bit-Release-Debian-Stable-Build",
        "WPE-Linux-64-bit-Release-Non-Unified-Build", "WPE-Linux-ARM64-bit-Release-Build"
      ],
      "nightly_builders": [
        "GTK-Linux-64bit-Release-GNOMEWebCanary-Packaging-Nightly",
        "GTK-Linux-64bit-Release-Packaging-Nightly",
        "WPE-Linux-64bit-Release-Packaging-Nightly"
      ]
    },
    "in": {
      "$let": {
        "ps_builders": {
          "$map": {"$eval": "builders"},
          "each(b)": {
            "$if": "!('triggered_by' in b) && !(b.name in main_builders) && !(b.name in nightly_builders)",
            "then": {"$eval": "b"}
          }
        }
      },
      "in": {
        "$flatten": [
          [
            {"type": "AnyBranchScheduler", "name": "main", "change_filter": "main_filter",
             "treeStableTimer": 45.0, "builderNames": {"$eval": "main_builders"}},
            {"type": "Nightly", "name": "NightlyScheduler", "change_filter": "main_filter",
             "branch": "main", "hour": 22, "minute": 0, "builderNames": {"$eval": "nightly_builders"}}
          ],
          {"$map": {"$eval": "builders"},
           "each(b)": {
            "$if": "'triggered_by' in b",
            "then": {"type": "Triggerable", "name": {"$eval": "lowercase(b.name)"},
                     "builderNames": [{"$eval": "b.name"}]}
          }},
          {"$map": {"$eval": "to_entries(group_by(ps_builders, 'b', 'b.platform'))"},
           "each(entry)": {
            "type": "PlatformSpecificScheduler",
            "platform": {"$eval": "entry.key"},
            "branch": "main",
            "treeStableTimer": 45.0,
            "builderNames": {"$map": {"$eval": "entry.val"}, "each(b)": {"$eval": "b.name"}}
          }}
        ]
      }
    }
  }
}
