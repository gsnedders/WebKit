          "triggers": ["wpe-linux-rpi4-32bits-mesa-release-perf-tests"], "workernames": ["wpe-linux-bot-17"] },
        { "name": "WPE-Linux-RPi4-32bits-Mesa-Release-Perf-Tests", "factory": "CrossTargetDownloadAndPerfTestFactory",
          "triggered_by": ["wpe-linux-rpi4-32bits-mesa-release-perf-build"],
          "workernames": ["wpe-linux-bot-19", "wpe-linux-bot-20", "wpe-linux-bot-21", "wpe-linux-bot-22",
                          "wpe-linux-bot-23", "wpe-linux-bot-24", "wpe-linux-bot-25", "wpe-linux-bot-26"] }
      ], "each(b)": { "$merge": [{ "$eval": "d" }, { "$eval": "b" }] } }
    },
    [
